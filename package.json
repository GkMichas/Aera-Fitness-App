{
  "name": "aera-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "validate:training": "node scripts/validate-training-catalog.mjs",
    "test:training": "node --experimental-strip-types scripts/test-training-engine.mts",
    "validate:nutrition": "node scripts/validate-nutrition-catalog.mjs",
    "validate:media": "node --experimental-strip-types scripts/validate-media.mts",
    "test:nutrition": "node --experimental-strip-types scripts/test-nutrition.mts",
    "test:coach": "node --experimental-strip-types scripts/test-coach-engine.mts",
    "test:progress": "node --experimental-strip-types scripts/test-progress-engine.mts",
    "test:health": "node --experimental-strip-types scripts/test-health-safety.mts"
    ,"check:english": "node scripts/check-english-only.mjs"
    ,"typecheck": "tsc --noEmit"
    ,"test": "npm run validate:training && npm run test:training && npm run validate:nutrition && npm run test:nutrition && npm run validate:media && npm run test:coach && npm run test:progress && npm run test:health && npm run check:english"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "lucide-react": "^0.468.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0"
  }
}
