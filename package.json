{
  "name": "aera-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:sites": "opennextjs-cloudflare build --skipWranglerConfigCheck && node scripts/prepare-sites-dist.mjs",
    "start": "next start",
    "lint": "eslint .",
    "validate:training": "node scripts/validate-training-catalog.mjs",
    "test:training": "node --experimental-strip-types scripts/test-training-engine.mts",
    "validate:nutrition": "node scripts/validate-nutrition-catalog.mjs",
    "validate:media": "node --experimental-strip-types scripts/validate-media.mts",
    "test:nutrition": "node --experimental-strip-types scripts/test-nutrition.mts",
    "test:coach": "node --experimental-strip-types scripts/test-coach-engine.mts",
    "test:progress": "node --experimental-strip-types scripts/test-progress-engine.mts",
    "test:health": "node --experimental-strip-types scripts/test-health-safety.mts",
    "check:english": "node scripts/check-english-only.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run validate:training && pnpm run test:training && pnpm run validate:nutrition && pnpm run test:nutrition && pnpm run validate:media && pnpm run test:coach && pnpm run test:progress && pnpm run test:health && pnpm run check:english"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.124.0"
  }
}
